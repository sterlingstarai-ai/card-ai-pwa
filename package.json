{
  "name": "card-ai",
  "version": "1.0.2",
  "description": "Card AI - 신용카드 혜택 추천 앱",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src api tests",
    "lint:fix": "eslint src api tests --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test:unit": "vitest run",
    "validate": "node scripts/validate-data.js",
    "data:top50": "node scripts/generate-top50-places.js",
    "data:seed-missing-benefits": "node scripts/seed-missing-card-benefits.js",
    "secrets:check": "node scripts/secrets-check.js",
    "vercel:env:sync": "bash scripts/vercel-sync-env.sh",
    "deploy:smoke": "bash scripts/prod-smoke-check.sh",
    "release:postdeploy": "bash scripts/prod-smoke-check.sh",
    "release:preflight": "bash scripts/release-preflight.sh",
    "test:e2e": "playwright test",
    "test:e2e:app": "playwright test tests/e2e/app.spec.js",
    "ci": "npm run lint && npm run validate && npm run test:unit && npm run build && npm run secrets:check",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:build:ios": "npm run build && npx cap sync ios",
    "cap:build:android": "npm run build && npx cap sync android",
    "data:scrape": "node scripts/ingest/01_scrape_card_pages.js",
    "data:extract": "node scripts/ingest/02_extract_benefits_openai.js",
    "data:merge": "node scripts/ingest/03_merge_to_src_data.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "^8.0.2",
    "@capawesome/capacitor-app-review": "^8.0.1",
    "@sentry/react": "^10.38.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "firebase": "^12.9.0",
    "mixpanel-browser": "^2.74.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.1",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^28.1.0",
    "openai": "^4.77.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^4.0.18"
  }
}
