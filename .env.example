# Card AI PWA Environment Variables
# Copy this file to .env.local for local development

# Kakao Map JavaScript API Key (required for map feature)
# Get from: https://developers.kakao.com/
VITE_KAKAO_APP_KEY=your_kakao_javascript_key_here

# Note: VISION_API_KEY is set in Vercel environment variables only
# It should NOT be in .env files (server-side only)

# Analytics
VITE_MIXPANEL_TOKEN=your_mixpanel_token_here
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","appId":"...","measurementId":"..."}

# Upstash Rate Limit (server-side / Vercel)
# KV_REST_API_URL / KV_REST_API_TOKEN (Vercel KV) 도 인식됨
UPSTASH_REDIS_REST_URL=your_upstash_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Endpoint Auth (Phase 1: 공유 앱 토큰) — 비브라우저 프록시 남용 차단
# 서버(Vercel)와 클라이언트(VITE_) 값이 동일해야 함. 미설정 시 검증 비활성(기존 동작).
# 자세한 로드맵: docs/ENDPOINT_AUTH_PLAN.md
APP_REQUEST_SECRET=your_shared_app_request_secret
VITE_APP_REQUEST_SECRET=your_shared_app_request_secret
# 버전 게이트(마이그레이션): 이 버전 미만(또는 x-app-version 미상)인 구버전 앱은 토큰 없이
# 통과시키고, 이 버전 이상만 토큰을 강제한다. = "토큰을 싣기 시작한 첫 릴리스 버전"으로 설정.
# 미설정이면 (시크릿이 있을 때) 모든 요청에 토큰 강제(strict). 구버전 출시 앱이 남아 있으면 깨짐.
APP_AUTH_MIN_VERSION=

# Cost circuit-breaker (Phase 1.5) — 엔드포인트별 전역 일일 호출 상한(서버 전용).
# 미설정/0 이면 비활성. IP 회전 우회까지 Vision/Kakao 최악의 청구액을 상한으로 묶음.
OCR_DAILY_MAX=0
IDENTIFY_DAILY_MAX=0
KAKAO_DAILY_MAX=0
